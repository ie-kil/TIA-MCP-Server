{
  "name": "hmi_set_expression_dynamization_entries",
  "description": "Replace the ordered condition/value rows of one expression dynamization in place and verify the read-back.",
  "parameters": {
    "type": "object",
    "properties": {
      "screen_name": {
        "type": "string",
        "description": "Target screen."
      },
      "item_name": {
        "type": "string",
        "description": "Target screen item."
      },
      "property_name": {
        "type": "string",
        "description": "Property whose Expressions-tab condition rows to set, such as Top or Visible."
      },
      "entries": {
        "type": "array",
        "description": "Non-empty, ordered list of Boolean condition expressions and mapped property values. Replaces all rows for this property.",
        "items": {
          "type": "object",
          "description": "",
          "properties": {
            "condition": {
              "type": "string",
              "description": "WinCC Unified condition expression; its syntax is validated by TIA, not this tool."
            },
            "value": {
              "type": "object",
              "description": "",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Typed mapped value; must match the target property's CLR type.",
                  "enum": [
                    "Boolean",
                    "Color",
                    "String",
                    "Byte",
                    "Int16",
                    "UInt16",
                    "Int32",
                    "UInt32",
                    "Int64",
                    "UInt64",
                    "Single",
                    "Double",
                    "Decimal"
                  ]
                },
                "value": {
                  "type": "string",
                  "description": "Mapped value encoded as text (for example \"500\", \"true\", or \"#00FF00\")."
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "condition",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "on_conflict": {
        "type": "string",
        "description": "Whether an existing dynamization on this property may be replaced (default: fail).",
        "enum": [
          "fail",
          "replace"
        ],
        "default": "fail"
      },
      "target_name": {
        "type": "string",
        "description": "Target HMI software name (optional)."
      }
    },
    "required": [
      "screen_name",
      "item_name",
      "property_name",
      "entries"
    ],
    "additionalProperties": false
  }
}
