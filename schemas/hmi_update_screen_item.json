{
  "name": "hmi_update_screen_item",
  "description": "Update allowlisted screen-item properties in place and verify the resulting item state.",
  "parameters": {
    "type": "object",
    "properties": {
      "screen_name": {
        "type": "string",
        "description": "Name of the screen containing the item."
      },
      "item_name": {
        "type": "string",
        "description": "Name of the item to update."
      },
      "item_properties": {
        "type": "object",
        "description": "Non-empty object of supported property/value pairs. Allowed names: Visible, Left, Top, Width, Height, CenterX, CenterY, Radius, BackColor, ForeColor, BorderColor, BorderWidth.",
        "properties": {
          "Visible": {
            "type": "boolean",
            "description": "Whether the item is visible."
          },
          "Left": {
            "type": "integer",
            "description": "Horizontal position."
          },
          "Top": {
            "type": "integer",
            "description": "Vertical position."
          },
          "Width": {
            "type": "integer",
            "description": "Item width."
          },
          "Height": {
            "type": "integer",
            "description": "Item height."
          },
          "CenterX": {
            "type": "integer",
            "description": "Circle center X coordinate."
          },
          "CenterY": {
            "type": "integer",
            "description": "Circle center Y coordinate."
          },
          "Radius": {
            "type": "integer",
            "description": "Circle radius."
          },
          "BackColor": {
            "type": "string",
            "description": "Background color (#RRGGBB, #AARRGGBB, or supported TIA color name)."
          },
          "ForeColor": {
            "type": "string",
            "description": "Foreground/text color (#RRGGBB, #AARRGGBB, or supported TIA color name)."
          },
          "BorderColor": {
            "type": "string",
            "description": "Border color (#RRGGBB, #AARRGGBB, or supported TIA color name)."
          },
          "BorderWidth": {
            "type": "integer",
            "description": "Border width."
          }
        },
        "additionalProperties": false
      },
      "target_name": {
        "type": "string",
        "description": "Target HMI software name (optional)."
      }
    },
    "required": [
      "screen_name",
      "item_name",
      "item_properties"
    ],
    "additionalProperties": false
  }
}
