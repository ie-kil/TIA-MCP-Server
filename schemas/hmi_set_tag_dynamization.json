{
  "name": "hmi_set_tag_dynamization",
  "description": "Set tag dynamization on a screen item property using numeric ranges or Boolean Singlebit mapping.",
  "parameters": {
    "type": "object",
    "properties": {
      "screen_name": {
        "type": "string",
        "description": "Screen name."
      },
      "item_name": {
        "type": "string",
        "description": "Item name."
      },
      "property_name": {
        "type": "string",
        "description": "Property to dynamize (e.g. \u0027BackColor\u0027, \u0027Visibility\u0027)."
      },
      "tag_name": {
        "type": "string",
        "description": "HMI tag name to evaluate."
      },
      "condition_type": {
        "type": "string",
        "description": "\u0027None\u0027, \u0027Range\u0027, or \u0027Singlebit\u0027."
      },
      "ranges": {
        "type": "array",
        "description": "For Range, list numeric from/to bounds. For Singlebit, provide exactly two entries with matching bounds 0/0 and 1/1; their values map the off/on states.",
        "items": {
          "type": "object",
          "description": "",
          "properties": {
            "from": {
              "type": "number",
              "description": ""
            },
            "to": {
              "type": "number",
              "description": ""
            },
            "value": {
              "type": "string",
              "description": ""
            }
          },
          "required": [
            "from",
            "to",
            "value"
          ]
        }
      },
      "target_name": {
        "type": "string",
        "description": "Target HMI software name (optional)."
      }
    },
    "required": [
      "screen_name",
      "item_name",
      "property_name",
      "tag_name"
    ],
    "additionalProperties": false
  }
}